# ================================
# WINbd backend — переменные окружения
# Скопируй этот файл в .env и заполни своими значениями:
#   cp .env.example .env
# Файл .env НЕ попадает в git (см. .gitignore) — это наши секреты!
# ================================

# Порт, на котором будет работать API
PORT=5000

# Строка подключения к MongoDB Atlas
# Создай бесплатный кластер M0 на https://www.mongodb.com/atlas,
# затем: Database Access → создай пользователя БД,
#        Network Access → разреши доступ с твоего IP,
#        Connect → Drivers → скопируй строку вида:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/winbd?retryWrites=true&w=majority

# Секрет для подписи JWT (придумай длинную случайную строку)
# В терминале можно сгенерировать: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=сюда_вставь_длинный_случайный_секрет

# Срок жизни токена (например 7d — семь дней)
JWT_EXPIRES_IN=7d

# Домен фронтенда для CORS (в dev — Next.js на localhost:3000):
# CORS_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:3000